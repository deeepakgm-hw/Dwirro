NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://username:password@localhost:5432/dbname?schema=public
REDIS_URL=redis://localhost:6379
JWT_SECRET=replace_with_a_secure_jwt_secret_min_32_chars
JWT_REFRESH_SECRET=replace_with_a_secure_jwt_refresh_secret_min_32_chars
ENCRYPTION_KEY=replace_with_a_secure_encryption_key_32_chars_long
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3000/modules/auth/google/callback
LLM_PROVIDER=openai
LLM_API_KEY=your_llm_api_key_here
STT_PROVIDER=whisper
TTS_PROVIDER=elevenlabs
FCM_SERVER_KEY=your_fcm_server_key
SMS_PROVIDER_KEY=your_sms_provider_key
TELECOM_PROVIDER_KEY=your_telecom_provider_key
STUN_URL=stun:stun.l.google.com:19302
TURN_URL=turn:localhost:3478
TURN_USER=your_turn_user
TURN_PASSWORD=your_turn_password
LOG_LEVEL=info
